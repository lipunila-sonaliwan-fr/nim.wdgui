// ---- Model generated by wdreka: « Manufacturing workshop » ----
//@begin __doc
const HORIZON = 48;
//@end __doc

//@begin n1 horaire_jours
const n1_h_a = [j * 24 + 8 | j in 0..2 - 1];
const n1_h_b = [j * 24 + 18 | j in 0..2 - 1];
//@end n1

//@begin n10 tache
var n10_task_s : 0..HORIZON;
let n10_task_d = 2;
let n10_task_e = n10_task_s + n10_task_d;
constraint n10_task_e <= HORIZON;
//@end n10

//@begin n20 utilise
let n20_u_s = n10_task_s;
let n20_u_d = n10_task_d;
let n20_u_q = 1;
//@end n20

//@begin n30 produit
let n30_f_t = n10_task_e;
let n30_f_dq = 6;
//@end n30

//@begin n11 tache
var n11_task_s : 0..HORIZON;
let n11_task_d = 3;
let n11_task_e = n11_task_s + n11_task_d;
constraint n11_task_e <= HORIZON;
//@end n11

//@begin n21 utilise
let n21_u_s = n11_task_s;
let n21_u_d = n11_task_d;
let n21_u_q = 1;
//@end n21

//@begin n31 consomme
let n31_f_t = n11_task_s;
let n31_f_dq = -(4);
//@end n31

//@begin n22 utilise
let n22_u_s = n11_task_s;
let n22_u_d = n11_task_d;
let n22_u_q = 1;
//@end n22

//@begin n33 produit
let n33_f_t = n11_task_e;
let n33_f_dq = 4;
//@end n33

//@begin n12 tache
var n12_task_s : 0..HORIZON;
let n12_task_d = 4;
let n12_task_e = n12_task_s + n12_task_d;
constraint n12_task_e <= HORIZON;
//@end n12

//@begin n32 consomme
let n32_f_t = n12_task_s;
let n32_f_dq = -(5);
//@end n32

//@begin n5 matiere
constraint reservoir([n30_f_t, n31_f_t, n32_f_t], [n30_f_dq, n31_f_dq, n32_f_dq], 4, 0, 12);
//@end n5

//@begin n23 utilise
let n23_u_s = n12_task_s;
let n23_u_d = n12_task_d;
let n23_u_q = 1;
//@end n23

//@begin n3 equipement
const n3_cap = 1;
constraint cumulative([n21_u_s, n23_u_s], [n21_u_d, n23_u_d], [n21_u_q, n23_u_q], n3_cap);
constraint windows([n21_u_s, n23_u_s], [n21_u_d, n23_u_d], n1_h_a, n1_h_b);
//@end n3

//@begin n24 utilise
let n24_u_s = n12_task_s;
let n24_u_d = n12_task_d;
let n24_u_q = 1;
//@end n24

//@begin n34 produit
let n34_f_t = n12_task_e;
let n34_f_dq = 5;
//@end n34

//@begin n13 tache
var n13_task_s : 0..HORIZON;
let n13_task_d = 2;
let n13_task_e = n13_task_s + n13_task_d;
constraint n13_task_e <= HORIZON;
let n13_pred = [n11_task_e, n12_task_e];
constraint forall(i in 0..length(n13_pred) - 1)(n13_pred[i] <= n13_task_s);
//@end n13

//@begin n25 utilise
let n25_u_s = n13_task_s;
let n25_u_d = n13_task_d;
let n25_u_q = 1;
//@end n25

//@begin n36 consomme
let n36_f_t = n11_task_s;
let n36_f_dq = -(2);
//@end n36

//@begin n37 consomme
let n37_f_t = n12_task_s;
let n37_f_dq = -(3);
//@end n37

//@begin n7 consommable
constraint reservoir([n36_f_t, n37_f_t], [n36_f_dq, n37_f_dq], 6, 0, 6 + 1000000);
//@end n7

//@begin n14 tache
var n14_task_s : 0..HORIZON;
let n14_task_d = 1;
let n14_task_e = n14_task_s + n14_task_d;
constraint n14_task_e <= HORIZON;
let n14_pred = [n13_task_e];
constraint forall(i in 0..length(n14_pred) - 1)(n14_pred[i] <= n14_task_s);
//@end n14

//@begin n40 min_fin
solve minimize max([n10_task_e, n11_task_e, n12_task_e, n13_task_e, n14_task_e]);
//@end n40

//@begin n35 consomme
let n35_f_t = n14_task_s;
let n35_f_dq = -(8);
//@end n35

//@begin n6 matiere
constraint reservoir([n33_f_t, n34_f_t, n35_f_t], [n33_f_dq, n34_f_dq, n35_f_dq], 0, 0, 10);
//@end n6

//@begin n41 afficher_tache
output "Schedule: ", n14_task_s, " -> ", n14_task_e, "\n";
//@end n41

//@begin n26 utilise
let n26_u_s = n14_task_s;
let n26_u_d = n14_task_d;
let n26_u_q = 1;
//@end n26

//@begin n4 lieu
const n4_cap = 1;
constraint cumulative([n20_u_s, n26_u_s], [n20_u_d, n26_u_d], [n20_u_q, n26_u_q], n4_cap);
//@end n4

//@begin n27 utilise
let n27_u_s = n14_task_s;
let n27_u_d = n14_task_d;
let n27_u_q = 1;
//@end n27

//@begin n2 personnel
const n2_cap = 2;
constraint cumulative([n22_u_s, n24_u_s, n25_u_s, n27_u_s], [n22_u_d, n24_u_d, n25_u_d, n27_u_d], [n22_u_q, n24_u_q, n25_u_q, n27_u_q], n2_cap);
constraint windows([n22_u_s, n24_u_s, n25_u_s, n27_u_s], [n22_u_d, n24_u_d, n25_u_d, n27_u_d], n1_h_a, n1_h_b);
//@end n2
